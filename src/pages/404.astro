---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Página não encontrada"
  description="A página que você procura não existe ou foi movida. Navegue pelo site da Marca Lab."
  canonical="/404"
  noindex
>
  <section class="section">
    <div class="container-site mx-auto max-w-xl text-center">
      <p class="text-7xl font-black tracking-tight text-brand-100 sm:text-8xl">404</p>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        Página não encontrada
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        O endereço que você acessou não existe ou foi movido. Mas o seu próximo produto está a
        um clique:
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Voltar ao início</a>
        <a href="/produtos" class="btn-secondary">
          Ver produtos
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
