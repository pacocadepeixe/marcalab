---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import { PROCESS_STEPS } from '../data/site';
---

<BaseLayout
  title="Como Funciona o White Label de Suplementos"
  description="Entenda em 6 passos como funciona produzir suplementos com a sua marca: briefing, formulação, rótulo, regularização na ANVISA, produção e entrega em todo o Brasil."
  canonical="/como-funciona"
>
  <section class="section">
    <div class="container-site">
      <Breadcrumbs items={[{ label: 'Como Funciona' }]} />
      <div class="mx-auto mt-8 max-w-3xl text-center">
        <p class="eyebrow">
          <Icon name="factory" class="h-3.5 w-3.5" />
          Processo white label
        </p>
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Como funciona produzir com a sua marca
        </h1>
        <p class="lead text-lg sm:text-xl">
          Do primeiro contato ao produto pronto para vender, o caminho é claro e acompanhado.
          Veja o que acontece em cada etapa — e o que precisamos de você.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-16">
    <div class="container-site">
      <ol class="mx-auto max-w-3xl space-y-6">
        {
          PROCESS_STEPS.map((step) => (
            <li class="card relative overflow-hidden sm:p-8">
              <span class="pointer-events-none absolute -right-4 -top-6 select-none text-8xl font-black text-brand-50" aria-hidden="true">
                {step.number}
              </span>
              <div class="relative">
                <p class="text-sm font-bold uppercase tracking-wider text-brand-600">Passo {step.number}</p>
                <h2 class="mt-2 text-xl font-bold text-slate-900 sm:text-2xl">{step.title}</h2>
                <p class="mt-3 leading-relaxed text-slate-600">{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mx-auto mt-12 grid max-w-3xl gap-6 sm:grid-cols-3">
        <div class="rounded-2xl bg-brand-50 p-6 text-center ring-1 ring-brand-100">
          <Icon name="clock" class="mx-auto h-8 w-8 text-brand-700" />
          <p class="mt-3 text-2xl font-extrabold text-slate-900">30–60 dias</p>
          <p class="mt-1 text-sm text-slate-600">do briefing à entrega</p>
        </div>
        <div class="rounded-2xl bg-brand-50 p-6 text-center ring-1 ring-brand-100">
          <Icon name="doc" class="mx-auto h-8 w-8 text-brand-700" />
          <p class="mt-3 text-2xl font-extrabold text-slate-900">1 só parceiro</p>
          <p class="mt-1 text-sm text-slate-600">para tudo: fórmula, rótulo e produção</p>
        </div>
        <div class="rounded-2xl bg-brand-50 p-6 text-center ring-1 ring-brand-100">
          <Icon name="truck" class="mx-auto h-8 w-8 text-brand-700" />
          <p class="mt-3 text-2xl font-extrabold text-slate-900">Brasil inteiro</p>
          <p class="mt-1 text-sm text-slate-600">entrega com rastreio</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container-site mx-auto max-w-3xl">
      <h2 class="h2-section text-center">O que você precisa para começar</h2>
      <p class="lead text-center">
        A lista é curta — o resto é com a gente:
      </p>
      <ul class="mt-8 space-y-4">
        <li class="flex items-start gap-3 rounded-xl bg-white p-5 ring-1 ring-slate-200">
          <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
          <p><strong class="font-semibold text-slate-900">Uma empresa (CNPJ) ativa.</strong> Pode ser MEI ou LTDA; orientamos o enquadramento certo para vender suplementos.</p>
        </li>
        <li class="flex items-start gap-3 rounded-xl bg-white p-5 ring-1 ring-slate-200">
          <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
          <p><strong class="font-semibold text-slate-900">A definição de quais produtos lançar.</strong> Se ainda não souber, nossa equipe indica o mix ideal para o seu público e orçamento.</p>
        </li>
        <li class="flex items-start gap-3 rounded-xl bg-white p-5 ring-1 ring-slate-200">
          <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
          <p><strong class="font-semibold text-slate-900">Sua marca (nome e identidade).</strong> Tem logotipo? Ótimo. Não tem? Indicamos parceiros de design ou usamos sua identidade existente no rótulo.</p>
        </li>
      </ul>
      <p class="mt-8 rounded-2xl border border-dashed border-brand-300 bg-brand-50 p-5 text-center text-sm leading-relaxed text-slate-700">
        Quer se aprofundar antes? Leia nosso guia completo
        <a href="/blog/como-criar-uma-marca-de-suplementos-do-zero" class="font-semibold text-brand-700 underline">como criar uma marca de suplementos do zero</a>
        e entenda custos, margens e prazos de verdade.
      </p>
    </div>
  </section>

  <CTASection />
</BaseLayout>
