---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE, START_PRICE } from '../data/site';
---

<BaseLayout
  title="Cotação para sua Marca de Suplementos"
  description="Responda 5 perguntas rápidas e receba sua cotação de suplementos white label: momento da marca, produtos de interesse, faturamento e investimento. Primeiro lote a partir de R$ 5 mil."
  canonical="/contato"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contato e cotação — Marca Lab',
    url: `${SITE.url}/contato`,
  }}
>
  <section class="section">
    <div class="container-site">
      <Breadcrumbs items={[{ label: 'Contato' }]} />
      <div class="mx-auto mt-8 max-w-3xl text-center">
        <p class="eyebrow">
          <Icon name="whatsapp" class="h-3.5 w-3.5" />
          Cotação guiada · 1 minuto
        </p>
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Sua marca começa com 5 respostas
        </h1>
        <p class="lead text-lg">
          Responda rápido e receba no WhatsApp uma proposta sob medida — com produtos, formatos
          e condições para o seu momento. Primeiro lote a partir de
          <strong class="font-semibold text-slate-900">{START_PRICE}</strong>.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-8 lg:grid-cols-5">
        <!-- Canais diretos -->
        <div class="space-y-4 lg:col-span-2">
          <a
            href={SITE.contact.whatsapp}
            class="card flex items-center gap-4 hover:border-accent-300"
            rel="noopener"
            target="_blank"
          >
            <span class="card-icon shrink-0 bg-accent-50! text-accent-700! ring-accent-100!">
              <Icon name="whatsapp" class="h-6 w-6" />
            </span>
            <div>
              <p class="font-bold text-slate-900">Prefere direto no WhatsApp?</p>
              <p class="text-sm text-slate-600">{SITE.contact.whatsappDisplay} — clique e já abre com a mensagem pronta</p>
            </div>
          </a>
          <a href={`mailto:${SITE.contact.email}`} class="card flex items-center gap-4 hover:border-brand-300">
            <span class="card-icon shrink-0">
              <Icon name="mail" class="h-6 w-6" />
            </span>
            <div>
              <p class="font-bold text-slate-900">E-mail</p>
              <p class="text-sm text-slate-600">{SITE.contact.email}</p>
            </div>
          </a>
          <div class="card flex items-center gap-4">
            <span class="card-icon shrink-0">
              <Icon name="clock" class="h-6 w-6" />
            </span>
            <div>
              <p class="font-bold text-slate-900">Horário de atendimento</p>
              <p class="text-sm text-slate-600">Segunda a sexta, 9h às 18h (horário de Brasília)</p>
            </div>
          </div>
          <div class="rounded-2xl bg-slate-900 p-6 text-sm leading-relaxed text-slate-300">
            <p class="font-bold text-white">O que você recebe na cotação:</p>
            <ul class="mt-3 space-y-2">
              <li class="flex gap-2"><Icon name="check" class="h-4 w-4 shrink-0 text-accent-400" /> Condições do lote inicial</li>
              <li class="flex gap-2"><Icon name="check" class="h-4 w-4 shrink-0 text-accent-400" /> Prazo de produção e entrega</li>
              <li class="flex gap-2"><Icon name="check" class="h-4 w-4 shrink-0 text-accent-400" /> Orientação sobre regularização</li>
              <li class="flex gap-2"><Icon name="check" class="h-4 w-4 shrink-0 text-accent-400" /> Sugestão de mix para o seu público</li>
            </ul>
          </div>
        </div>

        <!-- Formulário multi-etapas -->
        <div class="lg:col-span-3">
          <QuoteForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
