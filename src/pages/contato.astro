---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { SITE, START_PRICE } from '../data/site';
---

<BaseLayout
  title="Contato e Cotação"
  description="Solicite uma cotação gratuita para produzir suplementos com a sua marca. Fale com a Marca Lab por WhatsApp, e-mail ou formulário — resposta em até 1 dia útil."
  canonical="/contato"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contato — Marca Lab',
    url: `${SITE.url}/contato`,
  }}
>
  <section class="section">
    <div class="container-site">
      <Breadcrumbs items={[{ label: 'Contato' }]} />
      <div class="mx-auto mt-8 max-w-3xl text-center">
        <p class="eyebrow">
          <Icon name="whatsapp" class="h-3.5 w-3.5" />
          Fale com a gente
        </p>
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Sua marca começa com um "oi"
        </h1>
        <p class="lead text-lg">
          Conte quais produtos você quer lançar — ou só diga que quer começar e a gente te
          orienta. Primeiro lote a partir de <strong class="font-semibold text-slate-900">{START_PRICE}</strong>,
          resposta rápida no WhatsApp.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-8 lg:grid-cols-5">
        <!-- Canais -->
        <div class="space-y-4 lg:col-span-2">
          <a
            href={SITE.contact.whatsapp}
            class="card flex items-center gap-4 hover:border-accent-300"
            rel="noopener"
            target="_blank"
          >
            <span class="card-icon shrink-0 bg-accent-50! text-accent-700! ring-accent-100!">
              <Icon name="whatsapp" class="h-6 w-6" />
            </span>
            <div>
              <p class="font-bold text-slate-900">WhatsApp (mais rápido)</p>
              <p class="text-sm text-slate-600">{SITE.contact.whatsappDisplay} — clique e já abre com a mensagem pronta</p>
            </div>
          </a>
          <a href={`mailto:${SITE.contact.email}`} class="card flex items-center gap-4 hover:border-brand-300">
            <span class="card-icon shrink-0">
              <Icon name="mail" class="h-6 w-6" />
            </span>
            <div>
              <p class="font-bold text-slate-900">E-mail</p>
              <p class="text-sm text-slate-600">{SITE.contact.email}</p>
            </div>
          </a>
          <div class="card flex items-center gap-4">
            <span class="card-icon shrink-0">
              <Icon name="clock" class="h-6 w-6" />
            </span>
            <div>
              <p class="font-bold text-slate-900">Horário de atendimento</p>
              <p class="text-sm text-slate-600">Segunda a sexta, 9h às 18h (horário de Brasília)</p>
            </div>
          </div>
          <div class="rounded-2xl bg-slate-900 p-6 text-sm leading-relaxed text-slate-300">
            <p class="font-bold text-white">Dica para agilizar sua cotação:</p>
            <ul class="mt-3 list-disc space-y-1.5 pl-4">
              <li>Quais produtos você quer (ex.: creatina 300 g, whey 900 g);</li>
              <li>Quantidade estimada do primeiro lote;</li>
              <li>Se já tem marca/logotipo e CNPJ ativo;</li>
              <li>Se prefere formulação pronta ou exclusiva.</li>
            </ul>
          </div>
        </div>

        <!-- Formulário -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:col-span-3">
          <h2 class="text-xl font-bold text-slate-900">Formulário de cotação</h2>
          <p class="mt-1.5 text-sm text-slate-600">
            Preencha os campos abaixo e clique em enviar — cai direto no nosso e-mail.
          </p>
          <!--
            INTEGRAÇÃO: aponte a action para seu serviço de formulário
            (Formspree, Getform, Tally, ActiveCampaign etc.) e adicione name=""
            aos campos. Até lá, o envio abre o cliente de e-mail preenchido.
          -->
          <form
            id="form-contato"
            class="mt-6 grid gap-5 sm:grid-cols-2"
            method="POST"
            action={`mailto:${SITE.contact.email}`}
            enctype="text/plain"
          >
            <div class="sm:col-span-1">
              <label for="nome" class="block text-sm font-semibold text-slate-800">Nome*</label>
              <input
                id="nome"
                name="nome"
                type="text"
                required
                autocomplete="name"
                class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
                placeholder="Seu nome completo"
              />
            </div>
            <div class="sm:col-span-1">
              <label for="whats" class="block text-sm font-semibold text-slate-800">WhatsApp*</label>
              <input
                id="whats"
                name="whatsapp"
                type="tel"
                required
                autocomplete="tel"
                class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
                placeholder="(11) 99999-9999"
              />
            </div>
            <div class="sm:col-span-1">
              <label for="email" class="block text-sm font-semibold text-slate-800">E-mail*</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
                placeholder="voce@empresa.com.br"
              />
            </div>
            <div class="sm:col-span-1">
              <label for="produto" class="block text-sm font-semibold text-slate-800">Produto de interesse</label>
              <select
                id="produto"
                name="produto"
                class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
              >
                <option>Creatina</option>
                <option>Whey Protein</option>
                <option>Ômega 3 / Óleos</option>
                <option>Colágeno</option>
                <option>Pré-treino / Energia</option>
                <option>Termogênico / Emagrecimento</option>
                <option>Vitaminas e Minerais</option>
                <option>Hipercalórico / Massa</option>
                <option>Outro / Mix de produtos</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="mensagem" class="block text-sm font-semibold text-slate-800">Mensagem*</label>
              <textarea
                id="mensagem"
                name="mensagem"
                required
                rows="5"
                class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
                placeholder="Ex.: Quero lançar creatina 300 g e whey 900 g com minha marca. Tenho CNPJ e logotipo prontos. Primeiro lote de ~300 unidades.">
              </textarea>
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="btn-primary w-full py-3.5! text-base!">
                Enviar solicitação
                <Icon name="arrow-right" class="h-4 w-4" />
              </button>
              <p class="mt-3 text-xs leading-relaxed text-slate-500">
                Ao enviar, você concorda com nossa
                <a href="/politica-de-privacidade" class="underline hover:text-brand-700">Política de Privacidade</a>.
                Seus dados não são compartilhados com terceiros.
              </p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
