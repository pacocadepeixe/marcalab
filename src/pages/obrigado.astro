---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Recebemos sua solicitação!"
  description="Sua solicitação de cotação foi registrada. A equipe Marca Lab responde em até 1 dia útil."
  canonical="/obrigado"
  noindex
>
  <section class="section">
    <div class="container-site mx-auto max-w-xl text-center">
      <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-accent-50 text-accent-600 ring-1 ring-accent-200">
        <Icon name="check" class="h-8 w-8" />
      </span>
      <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        Recebemos sua solicitação!
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        Obrigado pelo contato. Nossa equipe vai analisar seu pedido e responder em até
        <strong class="text-slate-900">1 dia útil</strong> com condições, prazos e próximos passos.
      </p>
      <p class="mt-4 text-slate-600">Quer agilizar? Chame a gente no WhatsApp:</p>
      <a href={SITE.contact.whatsapp} class="btn-primary mt-4" rel="noopener" target="_blank">
        <Icon name="whatsapp" class="h-5 w-5" />
        {SITE.contact.whatsappDisplay} — abre com a mensagem pronta
      </a>
      <div class="mt-10">
        <a href="/blog" class="text-sm font-semibold text-brand-700 underline hover:text-brand-800">
          Enquanto isso, leia nosso blog →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
