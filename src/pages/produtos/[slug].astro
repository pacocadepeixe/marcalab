---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, SITE, IMAGES, PRODUCT_IMAGE, START_PRICE } from '../../data/site';
import { PRODUCT_CONTENT } from '../../data/productContent';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const content = PRODUCT_CONTENT[product.slug];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: product.description,
    brand: { '@type': 'Brand', name: SITE.name },
    category: 'Suplementos alimentares',
    url: `${SITE.url}/produtos/${product.slug}`,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'BRL',
      availability: 'https://schema.org/InStock',
      seller: { '@type': 'Organization', name: SITE.name },
      description:
        'Produção sob demanda com pedido mínimo variável por formato. Solicite cotação para condições atualizadas.',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${product.name} — produção para terceiros`,
    provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    serviceType: 'White label / private label',
    areaServed: 'BR',
  },
];

const otherProducts = PRODUCTS.filter((p) => p.slug !== product.slug).slice(0, 4);
---

<BaseLayout
  title={product.headline}
  description={product.description}
  canonical={`/produtos/${product.slug}`}
  schema={schemas}
>
  <section class="section">
    <div class="container-site">
      <Breadcrumbs items={[{ label: 'Produtos', href: '/produtos' }, { label: product.name }]} />

      <div class="mt-8 grid items-start gap-12 lg:grid-cols-2">
        <div>
          <p class="eyebrow">
            <Icon name={product.icon} class="h-3.5 w-3.5" />
            White label · {product.name.replace(' White Label', '')}
          </p>
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
            {product.headline}
          </h1>
          <div class="quick-answer mt-6">
            <h2>
              <Icon name="bolt" class="h-3.5 w-3.5" />
              Visão rápida
            </h2>
            <p class="leading-relaxed text-slate-700">{content.quickAnswer}</p>
          </div>
          <div class="prose-blog mt-8">
            {content.intro.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-24">
          <figure class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-sm">
            <img
              src={PRODUCT_IMAGE[product.slug] ?? IMAGES.produto}
              alt={`Mockup do produto ${product.name.replace(' White Label', '')} com rótulo SUA MARCA AQUI`}
              class="mx-auto h-72 w-auto object-contain p-6 sm:h-80"
              width="576"
              height="640"
              loading="lazy"
            />
            <figcaption class="bg-white px-5 py-3 text-xs text-slate-500">
              Ilustração do formato — o rótulo segue 100% a identidade da sua marca
            </figcaption>
          </figure>
          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <h2 class="text-lg font-bold text-slate-900">Formatos disponíveis</h2>
            <ul class="mt-4 space-y-2.5">
              {
                product.forms.map((form) => (
                  <li class="flex items-center gap-2.5 text-sm font-medium text-slate-700">
                    <Icon name="check" class="h-4 w-4 shrink-0 text-accent-600" />
                    {form}
                  </li>
                ))
              }
            </ul>
            <h3 class="mt-6 text-sm font-bold uppercase tracking-wider text-slate-500">
              Diferenciais de produção
            </h3>
            <ul class="mt-3 space-y-2.5">
              {
                content.differentials.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" />
                    {item}
                  </li>
                ))
              }
            </ul>
            <a
              href={SITE.contact.whatsapp}
              class="btn-primary mt-6 w-full"
              rel="noopener"
              target="_blank"
            >
              <Icon name="whatsapp" class="h-5 w-5" />
              Cotar com a minha marca
            </a>
            <p class="mt-3 text-center text-xs text-slate-500">
              Lote inicial a partir de <strong class="font-semibold text-slate-700">{START_PRICE}</strong> · resposta rápida no WhatsApp
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container-site mx-auto max-w-3xl">
      <h2 class="h2-section">Por que este produto vende com a sua marca</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          content.why.map((item) => (
            <li class="flex items-start gap-3 rounded-xl bg-white p-5 ring-1 ring-slate-200">
              <Icon name="chart" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" />
              <span class="text-sm leading-relaxed text-slate-700">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-site mx-auto max-w-3xl">
      <FAQ items={content.faq} title={`Perguntas frequentes — ${product.name}`} />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container-site">
      <h2 class="h2-section text-center">Outras categorias para a sua marca</h2>
      <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {otherProducts.map((p) => <ProductCard slug={p.slug} name={p.name} short={p.short} icon={p.icon} />)}
      </div>
    </div>
  </section>

  <CTASection
    title={`Pronto para produzir ${product.name.replace(' White Label', '').toLowerCase()} com a sua marca?`}
    description="Solicite uma cotação gratuita e receba condições, pedido mínimo, prazos e o passo a passo completo para lançar este produto."
  />
</BaseLayout>
