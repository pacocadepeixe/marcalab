---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import BlogCard from '../components/BlogCard.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import { SITE, PRODUCTS, EXTRA_PORTFOLIO, STATS, PROCESS_STEPS, IMAGES, TRUST_BADGES, START_PRICE } from '../data/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Produção de suplementos white label',
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  areaServed: 'BR',
  description:
    'Indústria de suplementos white label: creatina, whey protein, ômega 3, colágeno, vitaminas e mais de 120 produtos produzidos com a marca do cliente.',
  serviceType: 'White label / private label de suplementos alimentares',
  url: SITE.url,
};
---

<BaseLayout title={SITE.title} description={SITE.description} canonical="/" schema={homeSchema}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
    <div class="container-site grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:py-28">
      <div>
        <p class="eyebrow">
          <Icon name="flask" class="h-3.5 w-3.5" />
          Indústria white label · Seu primeiro lote a partir de {START_PRICE}
        </p>
        <h1 class="text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Pare de revender a marca dos outros.
          <span class="text-brand-700">Lance a sua.</span>
        </h1>
        <p class="lead text-lg sm:text-xl">
          A Marca Lab é a indústria que produz creatina, whey protein, ômega 3 e mais de 120
          suplementos com <strong class="font-semibold text-slate-900">a sua marca no rótulo</strong> —
          da formulação à entrega. Você cuida das vendas. A gente cuida do resto.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={SITE.contact.whatsapp} class="btn-primary px-7! py-3.5! text-base!" rel="noopener" target="_blank">
            <Icon name="whatsapp" class="h-5 w-5" />
            Quero lançar minha marca
          </a>
          <a href="/produtos" class="btn-secondary px-7! py-3.5! text-base!">
            Ver o que produzimos
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
        <ul class="mt-8 grid gap-2.5 text-sm font-medium text-slate-600 sm:grid-cols-2">
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-4 w-4 text-accent-600" /> Produto pronto em 30–60 dias
          </li>
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-4 w-4 text-accent-600" /> Laudo de qualidade por lote
          </li>
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-4 w-4 text-accent-600" /> Margens de 2x a 3x sobre o custo
          </li>
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-4 w-4 text-accent-600" /> Zero fábrica, zero dor de cabeça
          </li>
        </ul>
      </div>

      <!-- Foto real + card de processo -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-tr from-brand-100 via-accent-100 to-transparent blur-2xl" aria-hidden="true"></div>
        <figure class="relative">
          <img
            src={IMAGES.laboratorio}
            alt="Analista em laboratório de controle de qualidade analisando amostras de matéria-prima de suplementos"
            class="aspect-[4/3] w-full rounded-3xl border border-white object-cover shadow-xl"
            width="1400"
            height="1050"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="sr-only">Controle de qualidade em laboratório na produção de suplementos</figcaption>
          <!-- Card flutuante: passos resumidos -->
          <div class="relative z-10 mx-4 -mt-14 rounded-2xl border border-slate-200 bg-white/95 p-5 shadow-xl backdrop-blur sm:mx-6">
            <p class="text-xs font-bold uppercase tracking-wider text-brand-700">Do briefing à entrega</p>
            <ol class="mt-3 space-y-2.5">
              {
                PROCESS_STEPS.slice(0, 4).map((step, i) => (
                  <li class="flex items-center gap-3 text-sm">
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-[11px] font-bold text-brand-700 ring-1 ring-brand-100">
                      {i + 1}
                    </span>
                    <span class={i < 3 ? 'font-medium text-slate-900' : 'font-medium text-slate-900'}>{step.title}</span>
                    {i === 3 && <span class="ml-auto rounded-full bg-accent-50 px-2 py-0.5 text-[11px] font-semibold text-accent-800 ring-1 ring-accent-200">→ entrega</span>}
                  </li>
                ))
              }
            </ol>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- BARRA DE CONFIANÇA -->
  <section class="border-b border-slate-200 bg-white">
    <div class="container-site grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        TRUST_BADGES.map((badge) => (
          <div class="flex gap-3.5">
            <span class="card-icon shrink-0 !h-11 !w-11">
              <Icon name={badge.icon} class="h-5 w-5" />
            </span>
            <div>
              <p class="text-sm font-bold text-slate-900">{badge.title}</p>
              <p class="mt-1 text-xs leading-relaxed text-slate-600">{badge.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- STATS -->
  <section class="border-y border-slate-200 bg-white">
    <div class="container-site grid grid-cols-2 gap-8 py-10 sm:py-12 lg:grid-cols-4">
      {
        STATS.map((stat) => (
          <div class="text-center">
            <p class="text-3xl font-extrabold tracking-tight text-brand-700 sm:text-4xl">{stat.value}</p>
            <p class="mt-1.5 text-sm font-medium text-slate-500">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PRODUTOS DESTAQUE -->
  <section class="section">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Portfólio</p>
        <h2 class="h2-section">Produtos que vendem todo mês — com o seu nome no rótulo</h2>
        <p class="lead">
          Suplemento é recompra: o cliente que gosta compra de novo todo mês. Comece pelas
          categorias mais procuradas do Brasil, todas produzíveis com a sua marca.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {PRODUCTS.map((p) => <ProductCard slug={p.slug} name={p.name} short={p.short} icon={p.icon} />)}
      </div>
      <div class="mt-10 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 sm:p-8">
        <h3 class="text-base font-bold text-slate-900">E não para por aí — a indústria também produz:</h3>
        <ul class="mt-4 grid gap-x-8 gap-y-3 text-sm text-slate-600 sm:grid-cols-2 lg:grid-cols-4">
          {
            EXTRA_PORTFOLIO.map((item) => (
              <li class="flex items-start gap-2">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" />
                <span>
                  <strong class="font-semibold text-slate-800">{item.name}:</strong> {item.examples}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mt-10 text-center">
        <a href="/produtos" class="btn-secondary">
          Ver todos os produtos em detalhe
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA (resumido) -->
  <section class="section section-alt">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Como funciona</p>
        <h2 class="h2-section">Do briefing ao produto pronto em 6 passos</h2>
        <p class="lead">
          Você não precisa entender de formulação, rotulagem nem burocracia. É só isso:
        </p>
      </div>
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          PROCESS_STEPS.map((step) => (
            <li class="card">
              <div class="flex items-center justify-between">
                <span class="card-icon">
                  <span class="text-sm font-extrabold">{step.number}</span>
                </span>
              </div>
              <h3 class="mt-4 text-lg font-bold text-slate-900">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{step.description}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-10 text-center">
        <a href="/como-funciona" class="btn-secondary">
          Entender o processo completo
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- ESTRUTURA (fotos reais) -->
  <section class="section">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">
          <Icon name="factory" class="h-3.5 w-3.5" />
          Nossa estrutura
        </p>
        <h2 class="h2-section">Uma indústria de verdade, por trás da sua marca</h2>
        <p class="lead">
          Produção profissional não é promessa — é processo. Conheça as etapas que
          garantem a qualidade de cada lote que sai com o seu nome.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        <figure class="group relative overflow-hidden rounded-3xl">
          <img
            src={IMAGES.laboratorio}
            alt="Profissional analisando amostras em laboratório de controle de qualidade"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
            width="1400"
            height="1050"
            loading="lazy"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/85 to-transparent p-5 pt-12">
            <p class="text-sm font-bold text-white">Controle de qualidade</p>
            <p class="mt-0.5 text-xs text-slate-200">Análise de matéria-prima e laudo por lote produzido</p>
          </figcaption>
        </figure>
        <figure class="group relative overflow-hidden rounded-3xl">
          <img
            src={IMAGES.envase}
            alt="Cápsulas de suplementos no processo de envase industrial"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
            width="1200"
            height="900"
            loading="lazy"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/85 to-transparent p-5 pt-12">
            <p class="text-sm font-bold text-white">Produção e envase</p>
            <p class="mt-0.5 text-xs text-slate-200">Pós, cápsulas e tabletes com acabamento premium</p>
          </figcaption>
        </figure>
        <figure class="group relative overflow-hidden rounded-3xl">
          <img
            src={IMAGES.producao}
            alt="Linha de produção industrial de suplementos alimentares"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
            width="1600"
            height="1200"
            loading="lazy"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/85 to-transparent p-5 pt-12">
            <p class="text-sm font-bold text-white">Análise e desenvolvimento</p>
            <p class="mt-0.5 text-xs text-slate-200">Formulação e testes conduzidos por equipe técnica</p>
          </figcaption>
        </figure>
        <figure class="group relative overflow-hidden rounded-3xl">
          <img
            src={IMAGES.logistica}
            alt="Armazém de expedição com produtos prontos para envio"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
            width="1200"
            height="900"
            loading="lazy"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/85 to-transparent p-5 pt-12">
            <p class="text-sm font-bold text-white">Logística e expedição</p>
            <p class="mt-0.5 text-xs text-slate-200">Envio para todo o Brasil com rastreio</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- DIFERENCIAIS -->
  <section class="section">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Por que a Marca Lab</p>
        <h2 class="h2-section">Revender dá margem apertada. Marca própria dá patrimônio.</h2>
        <p class="lead">
          Quem revende marcas grandes disputa preço com centenas de lojas. Quem tem marca própria
          define o preço, constrói fidelidade e cria um ativo que cresce a cada lote. A Marca Lab
          existe para colocar essa diferença no seu bolso.
        </p>
        <div class="mt-8 space-y-5">
          <div class="flex gap-4">
            <span class="card-icon shrink-0"><Icon name="shield" class="h-6 w-6" /></span>
            <div>
              <h3 class="font-bold text-slate-900">Qualidade que você pode prometer</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">
                Matéria-prima rastreada e laudo de análise por lote. O que está no rótulo é o que
                está no pote — e o seu nome é o que está em jogo.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="card-icon shrink-0"><Icon name="doc" class="h-6 w-6" /></span>
            <div>
              <h3 class="font-bold text-slate-900">Burocracia? Com a gente</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">
                Rotulagem dentro das normas, orientação em notificação e regularização. Você
                vende com segurança jurídica desde o primeiro lote.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="card-icon shrink-0"><Icon name="clock" class="h-6 w-6" /></span>
            <div>
              <h3 class="font-bold text-slate-900">Prazo que cabe no seu planejamento</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">
                Ciclo médio de 30 a 60 dias com comunicação clara em cada etapa — para você
                planejar lançamento, estoque e campanhas sem surpresa.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="card-icon shrink-0"><Icon name="truck" class="h-6 w-6" /></span>
            <div>
              <h3 class="font-bold text-slate-900">Reposição que não trava suas vendas</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">
                Envio para todo o Brasil com rastreio e reposição ágil. Clientes seus nunca
                ouvem "acabou o estoque".
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="rounded-3xl bg-slate-900 p-8 sm:p-10">
        <p class="eyebrow !bg-white/10 !text-white !ring-white/20">Para quem é</p>
        <h3 class="mt-4 text-xl font-bold text-white sm:text-2xl">
          Se você tem audiência, clientela ou autoridade… falta só o produto
        </h3>
        <p class="mt-4 leading-relaxed text-slate-300">
          Influenciadores, personal trainers, nutras, lojistas e academias usam o white label
          para transformar recomendação em receita recorrente — com margem de marca própria, não
          comissão de revenda. Do primeiro lote de teste à escala.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-slate-300">
          <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> Influenciadores e personal trainers</li>
          <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> Lojas de suplementos e e-commerces</li>
          <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> Nutricionistas e profissionais de saúde</li>
          <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> Academias e estúdios</li>
        </ul>
        <div class="mt-8 rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
          <p class="text-sm leading-relaxed text-slate-300">
            <strong class="font-semibold text-white">Comece pequeno, comece agora:</strong> o
            primeiro lote sai a partir de {START_PRICE}. Sem fábrica, sem CNPJ gigante, sem
            letra miúda.
          </p>
        </div>
        <a href={SITE.contact.whatsapp} class="btn-accent mt-6 w-full" rel="noopener" target="_blank">
          <Icon name="whatsapp" class="h-5 w-5" />
          Dar o primeiro passo no WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section section-alt">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Blog</p>
        <h2 class="h2-section">Conteúdo para crescer a sua marca</h2>
        <p class="lead">
          Guias sobre produtos, negócio, marketing e mercado de suplementos — o conhecimento
          que você precisa antes de investir.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
      <div class="mt-10 text-center">
        <a href="/blog" class="btn-secondary">
          Ver todos os artigos
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
