---
import { NAV, SITE } from '../data/site';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} — página inicial`}>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-700 text-white">
        <Icon name="flask" class="h-5 w-5" />
      </span>
      <span class="text-lg font-bold tracking-tight text-slate-900">
        Marca<span class="text-brand-700">Lab</span>
      </span>
    </a>

    <!-- Navegação desktop -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegação principal">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isCurrent(item.href)
                ? 'bg-brand-50 text-brand-700'
                : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={SITE.contact.whatsapp} class="btn-primary py-2! px-4!" rel="noopener" target="_blank">
        <Icon name="whatsapp" class="h-4 w-4" />
        Pedir cotação
      </a>
    </div>

    <!-- Botão menu mobile -->
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 lg:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Abrir menu de navegação"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </div>

  <!-- Menu mobile -->
  <nav
    id="menu-mobile"
    class="hidden border-t border-slate-200 bg-white lg:hidden"
    aria-label="Navegação móvel"
  >
    <div class="container-site flex flex-col gap-1 py-4">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-3 text-base font-medium',
              isCurrent(item.href)
                ? 'bg-brand-50 text-brand-700'
                : 'text-slate-700 hover:bg-slate-50',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={SITE.contact.whatsapp}
        class="btn-primary mt-2 w-full"
        rel="noopener"
        target="_blank"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        Pedir cotação no WhatsApp
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute(
      'aria-label',
      isOpen ? 'Abrir menu de navegação' : 'Fechar menu de navegação'
    );
  });
</script>
