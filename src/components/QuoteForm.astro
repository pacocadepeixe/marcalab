---
import Icon from './Icon.astro';

/**
 * Formulário multi-etapas de cotação (5 passos → WhatsApp).
 * Usar UMA instância por página — os IDs internos são únicos.
 */
---

<div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <div id="cotacao-header">
    <div class="flex items-center justify-between text-sm">
      <p class="font-semibold text-brand-700" id="step-label">Etapa 1 de 5</p>
      <p class="text-slate-500" id="step-percent">0%</p>
    </div>
    <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuemin="0" aria-valuemax="100" id="progress-bar" aria-valuenow="0">
      <div class="h-full w-0 rounded-full bg-brand-600 transition-all duration-300" id="progress-fill"></div>
    </div>
    <h2 class="mt-6 text-xl font-bold text-slate-900" id="step-title">Qual é o seu momento?</h2>
    <p class="mt-1 text-sm text-slate-500" id="step-subtitle">Escolha a opção que mais se aproxima.</p>
  </div>

  <form id="cotacao-form" novalidate>
    <!-- Etapa 1: momento -->
    <fieldset class="form-step mt-6" data-step="1" data-question="Momento">
      <legend class="sr-only">Qual é o seu momento?</legend>
      <div class="grid gap-3">
        <label class="option-card"><input type="radio" name="momento" value="Quero criar uma marca nova" class="peer sr-only" required>
          <span class="flex items-start gap-3"><Icon name="sparkle" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" /><span><strong class="font-semibold">Criar marca do zero</strong><br><span class="text-sm text-slate-500">Tenho audiência/clientela e quero lançar minha primeira linha</span></span></span>
        </label>
        <label class="option-card"><input type="radio" name="momento" value="Já tenho marca e quero cotar a produção" class="peer sr-only">
          <span class="flex items-start gap-3"><Icon name="tag" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" /><span><strong class="font-semibold">Já tenho marca</strong><br><span class="text-sm text-slate-500">Quero cotar a produção dos meus produtos</span></span></span>
        </label>
        <label class="option-card"><input type="radio" name="momento" value="Já produzo e quero trocar de fornecedor" class="peer sr-only">
          <span class="flex items-start gap-3"><Icon name="factory" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" /><span><strong class="font-semibold">Já produzo com outro fornecedor</strong><br><span class="text-sm text-slate-500">Quero avaliar a Marca Lab como nova indústria</span></span></span>
        </label>
      </div>
    </fieldset>

    <!-- Etapa 2: faturamento -->
    <fieldset class="form-step mt-6 hidden" data-step="2" data-question="Faturamento atual">
      <legend class="sr-only">Quanto sua empresa fatura hoje?</legend>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="option-card"><input type="radio" name="faturamento" value="Ainda não faturamos" class="peer sr-only" required><span class="font-semibold">Ainda não faturamos</span></label>
        <label class="option-card"><input type="radio" name="faturamento" value="Até R$ 10 mil/mês" class="peer sr-only"><span class="font-semibold">Até R$ 10 mil/mês</span></label>
        <label class="option-card"><input type="radio" name="faturamento" value="R$ 10 mil a R$ 50 mil/mês" class="peer sr-only"><span class="font-semibold">R$ 10 mil a R$ 50 mil/mês</span></label>
        <label class="option-card"><input type="radio" name="faturamento" value="R$ 50 mil a R$ 200 mil/mês" class="peer sr-only"><span class="font-semibold">R$ 50 mil a R$ 200 mil/mês</span></label>
        <label class="option-card"><input type="radio" name="faturamento" value="Mais de R$ 200 mil/mês" class="peer sr-only"><span class="font-semibold">Mais de R$ 200 mil/mês</span></label>
      </div>
    </fieldset>

    <!-- Etapa 3: produtos (múltipla) -->
    <fieldset class="form-step mt-6 hidden" data-step="3" data-question="Produtos de interesse">
      <legend class="sr-only">Quais produtos têm interesse?</legend>
      <p class="mb-4 text-sm text-slate-500">Marque todos que quiser — pode escolher mais de um.</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="option-card"><input type="checkbox" name="produtos" value="Creatina" class="peer sr-only"><span class="font-semibold">Creatina</span></label>
        <label class="option-card"><input type="checkbox" name="produtos" value="Whey Protein" class="peer sr-only"><span class="font-semibold">Whey Protein</span></label>
        <label class="option-card"><input type="checkbox" name="produtos" value="Ômega 3 / Óleos" class="peer sr-only"><span class="font-semibold">Ômega 3 / Óleos</span></label>
        <label class="option-card"><input type="checkbox" name="produtos" value="Colágeno" class="peer sr-only"><span class="font-semibold">Colágeno</span></label>
        <label class="option-card"><input type="checkbox" name="produtos" value="Pré-treino" class="peer sr-only"><span class="font-semibold">Pré-treino / Energia</span></label>
        <label class="option-card"><input type="checkbox" name="produtos" value="Termogênico" class="peer sr-only"><span class="font-semibold">Termogênico</span></label>
        <label class="option-card"><input type="checkbox" name="produtos" value="Vitaminas e Minerais" class="peer sr-only"><span class="font-semibold">Vitaminas e Minerais</span></label>
        <label class="option-card"><input type="checkbox" name="produtos" value="Hipercalórico" class="peer sr-only"><span class="font-semibold">Hipercalórico</span></label>
        <label class="option-card"><input type="checkbox" name="produtos" value="Ainda nao sei - quero orientacao" class="peer sr-only"><span class="font-semibold">Ainda não sei — quero orientação</span></label>
      </div>
    </fieldset>

    <!-- Etapa 4: investimento -->
    <fieldset class="form-step mt-6 hidden" data-step="4" data-question="Investimento previsto">
      <legend class="sr-only">Quanto pretende investir no primeiro lote?</legend>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="option-card"><input type="radio" name="investimento" value="Até R$ 5 mil" class="peer sr-only" required><span class="font-semibold">Até R$ 5 mil</span></label>
        <label class="option-card"><input type="radio" name="investimento" value="R$ 5 mil a R$ 15 mil" class="peer sr-only"><span class="font-semibold">R$ 5 mil a R$ 15 mil</span></label>
        <label class="option-card"><input type="radio" name="investimento" value="R$ 15 mil a R$ 50 mil" class="peer sr-only"><span class="font-semibold">R$ 15 mil a R$ 50 mil</span></label>
        <label class="option-card"><input type="radio" name="investimento" value="Mais de R$ 50 mil" class="peer sr-only"><span class="font-semibold">Mais de R$ 50 mil</span></label>
      </div>
    </fieldset>

    <!-- Etapa 5: contato -->
    <fieldset class="form-step mt-6 hidden" data-step="5" data-question="Seus dados">
      <legend class="sr-only">Seus dados de contato</legend>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="f-nome" class="block text-sm font-semibold text-slate-800">Nome*</label>
          <input id="f-nome" name="nome" type="text" required autocomplete="name" class="input-field" placeholder="Seu nome completo">
        </div>
        <div>
          <label for="f-whats" class="block text-sm font-semibold text-slate-800">WhatsApp*</label>
          <input id="f-whats" name="whatsapp" type="tel" required autocomplete="tel" class="input-field" placeholder="(11) 90000-0000">
        </div>
        <div>
          <label for="f-email" class="block text-sm font-semibold text-slate-800">E-mail*</label>
          <input id="f-email" name="email" type="email" required autocomplete="email" class="input-field" placeholder="voce@empresa.com.br">
        </div>
        <div class="sm:col-span-2">
          <label for="f-msg" class="block text-sm font-semibold text-slate-800">Quer contar algo mais? <span class="font-normal text-slate-400">(opcional)</span></label>
          <textarea id="f-msg" name="mensagem" rows="3" class="input-field" placeholder="Ex.: tenho logotipo pronto, pretendo lançar em novembro…"></textarea>
        </div>
      </div>
      <p class="mt-4 text-xs leading-relaxed text-slate-500">
        Ao enviar, seu resumo chega direto no nosso WhatsApp e a resposta volta por lá ou
        por e-mail. Seus dados não são compartilhados — veja nossa
        <a href="/politica-de-privacidade" class="underline hover:text-brand-700">Política de Privacidade</a>.
      </p>
    </fieldset>

    <!-- Erro de validação -->
    <p id="form-error" class="mt-4 hidden rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700 ring-1 ring-red-200" role="alert"></p>

    <!-- Navegação -->
    <div class="mt-8 flex items-center gap-3">
      <button type="button" id="btn-back" class="btn-secondary hidden">
        <Icon name="arrow-left" class="h-4 w-4" />
        Voltar
      </button>
      <button type="button" id="btn-next" class="btn-primary flex-1 sm:flex-none sm:px-10">
        Continuar
        <Icon name="arrow-right" class="h-4 w-4" />
      </button>
      <button type="submit" id="btn-submit" class="btn-accent hidden flex-1 sm:flex-none sm:px-10">
        <Icon name="whatsapp" class="h-5 w-5" />
        Receber cotação no WhatsApp
      </button>
    </div>
  </form>

  <!-- Sucesso -->
  <div id="form-success" class="hidden text-center">
    <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-accent-50 text-accent-600 ring-1 ring-accent-200">
      <Icon name="check" class="h-8 w-8" />
    </span>
    <h2 class="mt-5 text-2xl font-bold text-slate-900">Resposta registrada!</h2>
    <p class="mt-3 leading-relaxed text-slate-600">
      Estamos abrindo o WhatsApp com o seu resumo pronto — é só apertar enviar lá.
      Se a janela não abrir, clique no botão abaixo.
    </p>
    <a id="success-wa-link" href="#" class="btn-accent mt-6 w-full sm:w-auto" rel="noopener" target="_blank">
      <Icon name="whatsapp" class="h-5 w-5" />
      Abrir WhatsApp agora
    </a>
  </div>
</div>

<style>
  .option-card {
    display: block;
    cursor: pointer;
    border-radius: 0.75rem;
    border: 1px solid var(--color-slate-200);
    background: white;
    padding: 0.875rem 1rem;
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }
  .option-card:hover {
    border-color: var(--color-brand-300);
  }
  .option-card:has(input:checked) {
    border-color: var(--color-brand-600);
    background: var(--color-brand-50);
    box-shadow: 0 0 0 1px var(--color-brand-600);
  }
  .input-field {
    margin-top: 0.5rem;
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-slate-300);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: var(--color-slate-900);
    background: white;
  }
  .input-field:focus {
    outline: none;
    border-color: var(--color-brand-500);
    box-shadow: 0 0 0 3px var(--color-brand-100);
  }
</style>

<script>
  import { LEADS } from '../data/site';

  const WHATSAPP_NUMBER = '5511975736730';

  /** Envia o lead direto para o Google Sheets (se configurado). */
  function enviarLead(d: Record<string, string>) {
    if (!LEADS.webAppUrl) return;
    const url = LEADS.webAppUrl + (LEADS.webAppUrl.includes('?') ? '&' : '?') + 'token=' + encodeURIComponent(LEADS.token);
    fetch(url, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(d),
      keepalive: true,
    }).catch(() => {});
  }

  const steps = [
    { title: 'Qual é o seu momento?', subtitle: 'Escolha a opção que mais se aproxima.' },
    { title: 'Quanto sua empresa fatura hoje?', subtitle: 'Serve para dimensionarmos o lote ideal.' },
    { title: 'Quais produtos têm interesse?', subtitle: 'Marque todos que quiser — pode escolher mais de um.' },
    { title: 'Quanto pretende investir no primeiro lote?', subtitle: 'O lote inicial sai a partir de R$ 5 mil.' },
    { title: 'Onde te enviamos a proposta?', subtitle: 'Preencha para receber a cotação.' },
  ];

  const form = document.getElementById('cotacao-form') as HTMLFormElement | null;
  const stepFields = Array.from(document.querySelectorAll<HTMLFieldSetElement>('.form-step'));
  const stepLabel = document.getElementById('step-label');
  const stepTitle = document.getElementById('step-title');
  const stepSubtitle = document.getElementById('step-subtitle');
  const progressFill = document.getElementById('progress-fill');
  const progressBar = document.getElementById('progress-bar');
  const stepPercent = document.getElementById('step-percent');
  const btnBack = document.getElementById('btn-back') as HTMLButtonElement | null;
  const btnNext = document.getElementById('btn-next') as HTMLButtonElement | null;
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement | null;
  const formError = document.getElementById('form-error');
  const formSuccess = document.getElementById('form-success');
  const successWaLink = document.getElementById('success-wa-link') as HTMLAnchorElement | null;

  let current = 1;
  const total = steps.length;

  function showError(msg: string) {
    if (!formError) return;
    formError.textContent = msg;
    formError.classList.remove('hidden');
  }
  function clearError() {
    formError?.classList.add('hidden');
  }

  function render() {
    stepFields.forEach((f) => {
      f.classList.toggle('hidden', Number(f.dataset.step) !== current);
    });
    const s = steps[current - 1];
    if (stepLabel) stepLabel.textContent = `Etapa ${current} de ${total}`;
    if (stepTitle) stepTitle.textContent = s.title;
    if (stepSubtitle) stepSubtitle.textContent = s.subtitle;
    const pct = Math.round(((current - 1) / total) * 100);
    if (progressFill) progressFill.style.width = `${pct}%`;
    if (progressBar) progressBar.setAttribute('aria-valuenow', String(pct));
    if (stepPercent) stepPercent.textContent = `${pct}%`;
    const isLast = current === total;
    if (btnBack) btnBack.classList.toggle('hidden', current === 1);
    if (btnNext) btnNext.classList.toggle('hidden', isLast);
    if (btnSubmit) btnSubmit.classList.toggle('hidden', !isLast);
    clearError();
  }

  function validateStep(): boolean {
    const fieldset = stepFields.find((f) => Number(f.dataset.step) === current);
    if (!fieldset) return true;
    if (current < total) {
      const checked = fieldset.querySelectorAll('input:checked');
      if (checked.length === 0) {
        showError('Escolha pelo menos uma opção para continuar.');
        return false;
      }
    }
    if (current === total) {
      const nome = (document.getElementById('f-nome') as HTMLInputElement).value.trim();
      const whats = (document.getElementById('f-whats') as HTMLInputElement).value.trim();
      const email = (document.getElementById('f-email') as HTMLInputElement).value.trim();
      if (!nome || !whats || !email) {
        showError('Preencha nome, WhatsApp e e-mail para receber a proposta.');
        return false;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Confira o e-mail digitado — parece incompleto.');
        return false;
      }
    }
    return true;
  }

  function getCheckedValues(name: string): string[] {
    return Array.from(form?.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`) ?? []).map(
      (i) => i.value
    );
  }

  function buildMessage(): string {
    const nome = (document.getElementById('f-nome') as HTMLInputElement).value.trim();
    const whats = (document.getElementById('f-whats') as HTMLInputElement).value.trim();
    const email = (document.getElementById('f-email') as HTMLInputElement).value.trim();
    const msg = (document.getElementById('f-msg') as HTMLTextAreaElement).value.trim();
    const momento = getCheckedValues('momento')[0] ?? '';
    const faturamento = getCheckedValues('faturamento')[0] ?? '';
    const produtos = getCheckedValues('produtos').join(', ');
    const investimento = getCheckedValues('investimento')[0] ?? '';

    const lines = [
      '*Marca Lab — Nova cotação*',
      '',
      `*Momento:* ${momento}`,
      `*Faturamento atual:* ${faturamento}`,
      `*Produtos de interesse:* ${produtos || '—'}`,
      `*Investimento previsto:* ${investimento}`,
      '',
      `*Nome:* ${nome}`,
      `*WhatsApp:* ${whats}`,
      `*E-mail:* ${email}`,
    ];
    if (msg) lines.push('', `*Observações:* ${msg}`);
    return lines.join('\n');
  }

  btnNext?.addEventListener('click', () => {
    if (!validateStep()) return;
    if (current < total) {
      current++;
      render();
    }
  });

  btnBack?.addEventListener('click', () => {
    if (current > 1) {
      current--;
      render();
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateStep()) return;
    const mensagem = buildMessage();
    enviarLead({
      origem: 'Formulário do site',
      momento: getCheckedValues('momento')[0] ?? '',
      faturamento: getCheckedValues('faturamento')[0] ?? '',
      produtos: getCheckedValues('produtos').join(', '),
      investimento: getCheckedValues('investimento')[0] ?? '',
      nome: (document.getElementById('f-nome') as HTMLInputElement).value.trim(),
      whatsapp: (document.getElementById('f-whats') as HTMLInputElement).value.trim(),
      email: (document.getElementById('f-email') as HTMLInputElement).value.trim(),
      observacoes: (document.getElementById('f-msg') as HTMLTextAreaElement).value.trim(),
      pagina: location.pathname,
      texto: mensagem,
    });
    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(mensagem)}`;
    if (successWaLink) successWaLink.href = url;
    form.classList.add('hidden');
    const header = document.getElementById('cotacao-header');
    header?.classList.add('hidden');
    formSuccess?.classList.remove('hidden');
    window.location.href = url;
  });

  render();
</script>
