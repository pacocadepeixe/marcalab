---
/**
 * Componente SEO — injere meta tags, Open Graph, Twitter Cards,
 * canonical e schemas JSON-LD (Organization/WebSite globais +
 * schemas extras por página via prop `schema`).
 */
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Caminho canônico da página, ex.: '/produtos/creatina-white-label' */
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  /** Schemas JSON-LD adicionais específicos da página */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical = '/',
  ogType = 'website',
  ogImage = '/og-image.png',
  noindex = false,
  schema,
} = Astro.props;

const fullTitle = title === SITE.title ? title : `${title} | ${SITE.name}`;
const canonicalUrl = new URL(canonical, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

const globalSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    legalName: SITE.legalName,
    url: SITE.url,
    logo: new URL('/favicon.svg', SITE.url).href,
    foundingDate: SITE.foundingDate,
    email: SITE.contact.email,
    telephone: SITE.contact.phone || undefined,
    sameAs: [SITE.social.instagram, SITE.social.linkedin],
    address: SITE.address.street
      ? {
          '@type': 'PostalAddress',
          streetAddress: SITE.address.street,
          addressLocality: SITE.address.city,
          addressRegion: SITE.address.state,
          postalCode: SITE.address.zip,
          addressCountry: 'BR',
        }
      : undefined,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'pt-BR',
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
    },
  },
];

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [...globalSchemas, ...extraSchemas];
---

<!-- Primary meta tags -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content={SITE.author} />
<meta name="theme-color" content="#1D4ED8" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} — suplementos white label`} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="pt_BR" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
