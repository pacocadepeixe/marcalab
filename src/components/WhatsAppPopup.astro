---
import Icon from './Icon.astro';

/**
 * Botão flutuante de WhatsApp com popup-chat de cotação guiada.
 * As perguntas avançam sozinhas conforme a pessoa responde (sensação de
 * conversa humana) e, no final, o WhatsApp abre com tudo preenchido —
 * mesmos campos do formulário completo (/contato), para a mensagem ter
 * o mesmo formato em ambas as origens.
 */
---

<div id="wa-widget" class="fixed bottom-5 right-5 z-[60] sm:bottom-6 sm:right-6">
  <!-- Popup -->
  <div
    id="wa-popup"
    class="pointer-events-none absolute bottom-[4.5rem] right-0 w-[calc(100vw-2.5rem)] max-w-sm origin-bottom-right scale-95 opacity-0 transition-all duration-200 sm:w-96"
    role="dialog"
    aria-modal="false"
    aria-labelledby="wa-popup-title"
    aria-hidden="true"
  >
    <div class="flex max-h-[80vh] flex-col overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-slate-200">
      <!-- Cabeçalho (branco) -->
      <div class="flex items-center gap-3 border-b border-slate-200 bg-white px-4 py-3.5">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700 ring-1 ring-brand-100">
          <Icon name="flask" class="h-5 w-5" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-bold text-slate-900" id="wa-popup-title">Marca Lab — Suplementos White Label</p>
          <p class="mt-0.5 flex items-center gap-1.5 text-xs text-slate-500">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span id="wa-status">Online · responde em minutos</span>
          </p>
        </div>
        <button
          type="button"
          id="wa-close"
          class="flex h-8 w-8 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700"
          aria-label="Fechar"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>

      <!-- Área do chat -->
      <div id="wa-chat" class="min-h-[220px] flex-1 space-y-2 overflow-y-auto bg-white px-3 py-4" aria-live="polite"></div>

      <!-- Área de resposta (troca conforme a etapa) -->
      <div id="wa-inputs" class="border-t border-slate-200 bg-white p-3">
        <!-- Etapa 1: momento -->
        <div class="wa-step hidden" data-step="1">
          <p class="mb-2 text-xs font-semibold text-slate-500">Escolha uma opção:</p>
          <div class="grid gap-2">
            <button type="button" class="wa-chip-btn" data-value="Quero criar uma marca nova">🚀 Criar minha marca do zero</button>
            <button type="button" class="wa-chip-btn" data-value="Já tenho marca e quero cotar a produção">🏷️ Já tenho marca — cotar produção</button>
            <button type="button" class="wa-chip-btn" data-value="Já produzo e quero trocar de fornecedor">🔄 Trocar de fornecedor</button>
          </div>
        </div>

        <!-- Etapa 2: faturamento -->
        <div class="wa-step hidden" data-step="2">
          <p class="mb-2 text-xs font-semibold text-slate-500">Quanto sua empresa fatura hoje?</p>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" class="wa-chip-btn" data-value="Ainda não faturamos">Ainda não faturamos</button>
            <button type="button" class="wa-chip-btn" data-value="Até R$ 10 mil/mês">Até R$ 10 mil/mês</button>
            <button type="button" class="wa-chip-btn" data-value="R$ 10 mil a R$ 50 mil/mês">R$ 10–50 mil/mês</button>
            <button type="button" class="wa-chip-btn" data-value="R$ 50 mil a R$ 200 mil/mês">R$ 50–200 mil/mês</button>
            <button type="button" class="wa-chip-btn col-span-2" data-value="Mais de R$ 200 mil/mês">Mais de R$ 200 mil/mês</button>
          </div>
        </div>

        <!-- Etapa 3: produtos (múltipla) -->
        <div class="wa-step hidden" data-step="3">
          <p class="mb-2 text-xs font-semibold text-slate-500">Marque tudo que te interessa (pode ser mais de um):</p>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" class="wa-chip-btn wa-multi" data-value="Creatina">Creatina</button>
            <button type="button" class="wa-chip-btn wa-multi" data-value="Whey Protein">Whey Protein</button>
            <button type="button" class="wa-chip-btn wa-multi" data-value="Ômega 3">Ômega 3</button>
            <button type="button" class="wa-chip-btn wa-multi" data-value="Colágeno">Colágeno</button>
            <button type="button" class="wa-chip-btn wa-multi" data-value="Pré-treino">Pré-treino</button>
            <button type="button" class="wa-chip-btn wa-multi" data-value="Termogênico">Termogênico</button>
            <button type="button" class="wa-chip-btn wa-multi" data-value="Vitaminas">Vitaminas</button>
            <button type="button" class="wa-chip-btn wa-multi" data-value="Hipercalórico">Hipercalórico</button>
          </div>
          <button type="button" id="wa-produtos-ok" class="btn-primary mt-2.5 w-full py-2.5! text-sm!">
            Continuar
            <Icon name="arrow-right" class="h-4 w-4" />
          </button>
        </div>

        <!-- Etapa 4: investimento -->
        <div class="wa-step hidden" data-step="4">
          <p class="mb-2 text-xs font-semibold text-slate-500">Quanto pretende investir no primeiro lote?</p>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" class="wa-chip-btn" data-value="Até R$ 5 mil">Até R$ 5 mil</button>
            <button type="button" class="wa-chip-btn" data-value="R$ 5 mil a R$ 15 mil">R$ 5–15 mil</button>
            <button type="button" class="wa-chip-btn" data-value="R$ 15 mil a R$ 50 mil">R$ 15–50 mil</button>
            <button type="button" class="wa-chip-btn" data-value="Mais de R$ 50 mil">+ de R$ 50 mil</button>
          </div>
        </div>

        <!-- Etapa 5: contato -->
        <div class="wa-step hidden" data-step="5">
          <div class="grid gap-2.5">
            <input id="wa-nome" type="text" autocomplete="name" class="wa-input" placeholder="Seu nome*">
            <input id="wa-whats" type="tel" autocomplete="tel" class="wa-input" placeholder="Seu WhatsApp* (11) 90000-0000">
            <input id="wa-email" type="email" autocomplete="email" class="wa-input" placeholder="Seu e-mail*">
          </div>
          <p id="wa-error" class="mt-2 hidden rounded-lg bg-red-50 px-3 py-2 text-xs font-medium text-red-700 ring-1 ring-red-200" role="alert"></p>
          <button type="button" id="wa-enviar" class="mt-2.5 flex w-full items-center justify-center gap-2 rounded-lg bg-[#25D366] px-4 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-[#1eb85a]">
            <Icon name="whatsapp" class="h-5 w-5" />
            Receber cotação no WhatsApp
          </button>
          <p class="mt-2 text-center text-[11px] text-slate-400">Sem cadastro — a conversa abre preenchida.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Botão flutuante -->
  <button
    type="button"
    id="wa-toggle"
    class="relative flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition-transform duration-200 hover:scale-105 active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
    aria-label="Falar no WhatsApp"
    aria-expanded="false"
    aria-controls="wa-popup"
  >
    <span id="wa-ping" class="absolute inset-0 rounded-full bg-[#25D366] opacity-25" aria-hidden="true"></span>
    <span id="wa-icon-open" class="relative"><Icon name="whatsapp" class="h-7 w-7" /></span>
    <span id="wa-icon-close" class="relative hidden"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></span>
  </button>
</div>

<style>
  #wa-ping {
    animation: wa-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes wa-ping {
    0% { transform: scale(1); opacity: 0.25; }
    75%, 100% { transform: scale(1.6); opacity: 0; }
  }
  .wa-chip-btn {
    cursor: pointer;
    border-radius: 0.625rem;
    border: 1px solid var(--color-slate-200);
    background: white;
    padding: 0.5rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-slate-700);
    text-align: center;
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }
  .wa-chip-btn:hover {
    border-color: var(--color-brand-500);
    color: var(--color-brand-700);
  }
  .wa-chip-btn.wa-selected {
    border-color: var(--color-brand-600);
    background: var(--color-brand-50);
    color: var(--color-brand-800);
    box-shadow: 0 0 0 1px var(--color-brand-600);
  }
  .wa-input {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-slate-300);
    padding: 0.625rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-slate-900);
    background: white;
  }
  .wa-input:focus {
    outline: none;
    border-color: var(--color-brand-500);
    box-shadow: 0 0 0 3px var(--color-brand-100);
  }
  /* bolhas do chat */
  .wa-bubble-bot {
    max-width: 85%;
    width: fit-content;
    border-radius: 0.875rem 0.875rem 0.875rem 0.25rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-slate-800);
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.04);
    animation: wa-appear 0.18s ease-out;
  }
  .wa-bubble-user {
    max-width: 85%;
    margin-left: auto;
    width: fit-content;
    border-radius: 0.875rem 0.875rem 0.25rem 0.875rem;
    background: #dcf8c6;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.45;
    color: #0b2e13;
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.08);
    animation: wa-appear 0.18s ease-out;
  }
  .wa-typing {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.625rem 0.75rem;
  }
  .wa-typing span {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-slate-400);
    animation: wa-dot 1s infinite ease-in-out;
  }
  .wa-typing span:nth-child(2) { animation-delay: 0.15s; }
  .wa-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes wa-dot {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }
  @keyframes wa-appear {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    #wa-ping { animation: none; opacity: 0; }
    .wa-bubble-bot, .wa-bubble-user, .wa-typing span { animation: none; }
  }
</style>

<script>
  const WHATSAPP_NUMBER = '5511975736730';
  const AUTO_ABRIR_MS = 30_000; // abre sozinho após 30s na página (1× por sessão)

  const widget = document.getElementById('wa-widget');
  const popup = document.getElementById('wa-popup');
  const toggle = document.getElementById('wa-toggle') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('wa-close');
  const ping = document.getElementById('wa-ping');
  const iconOpen = document.getElementById('wa-icon-open');
  const iconClose = document.getElementById('wa-icon-close');
  const chat = document.getElementById('wa-chat');
  const inputs = document.getElementById('wa-inputs');
  const status = document.getElementById('wa-status');
  const error = document.getElementById('wa-error');

  type Etapa = { pergunta: string; atraso?: number };

  const etapas: Etapa[] = [
    { pergunta: 'Oi! 👋 Que bom te ver por aqui. Eu vou montar sua cotação em 1 minuto — o seu momento é qual?' },
    { pergunta: 'Show! E quanto a sua empresa fatura hoje por mês?' },
    { pergunta: 'Perfeito. Quais produtos têm interesse? Pode marcar mais de um 👇' },
    { pergunta: 'Boa! E quanto pretende investir no primeiro lote? (começa a partir de R$ 5 mil)' },
    { pergunta: 'Última: pra onde te envio a proposta? 😃' },
  ];

  const respostas: Record<string, string> = {};
  let etapaAtual = 0;
  let iniciado = false;
  let isOpen = false;

  function scrollToBottom() {
    if (chat) chat.scrollTop = chat.scrollHeight;
  }

  function addBubble(text: string, who: 'bot' | 'user') {
    if (!chat) return;
    const div = document.createElement('div');
    div.className = who === 'bot' ? 'wa-bubble-bot' : 'wa-bubble-user';
    div.textContent = text;
    chat.appendChild(div);
    scrollToBottom();
  }

  function botSay(text: string, atrasoMs = 650): Promise<void> {
    return new Promise((resolve) => {
      if (!chat) return resolve();
      const typing = document.createElement('div');
      typing.className = 'wa-bubble-bot wa-typing';
      typing.innerHTML = '<span></span><span></span><span></span>';
      chat.appendChild(typing);
      scrollToBottom();
      setTimeout(() => {
        typing.remove();
        addBubble(text, 'bot');
        resolve();
      }, atrasoMs);
    });
  }

  function showStep(n: number) {
    inputs?.querySelectorAll<HTMLDivElement>('.wa-step').forEach((el) => {
      el.classList.toggle('hidden', Number(el.dataset.step) !== n);
    });
    if (status) status.textContent = `Digitando… etapa ${n} de ${etapas.length}`;
  }

  async function comecarConversa() {
    if (iniciado) return;
    iniciado = true;
    await botSay(etapas[0].pergunta, 500);
    if (status) status.textContent = 'Online · responde em minutos';
    showStep(1);
  }

  async function avancar(campo: string, valor: string) {
    respostas[campo] = valor;
    addBubble(valor, 'user');
    etapaAtual++;
    if (etapaAtual >= etapas.length) return;
    inputs?.querySelectorAll('.wa-step').forEach((el) => el.classList.add('hidden'));
    await botSay(etapas[etapaAtual].pergunta);
    if (status) status.textContent = 'Online · responde em minutos';
    showStep(etapaAtual + 1);
  }

  function jaViuNestaSessao(): boolean {
    try {
      return sessionStorage.getItem('marcalab-wa-visto') === '1';
    } catch {
      return false;
    }
  }
  function marcarVisto() {
    try {
      sessionStorage.setItem('marcalab-wa-visto', '1');
    } catch {
      /* modo privado — segue sem persistir */
    }
  }

  function setOpen(open: boolean) {
    isOpen = open;
    if (!popup || !toggle) return;
    popup.classList.toggle('opacity-0', !open);
    popup.classList.toggle('scale-95', !open);
    popup.classList.toggle('pointer-events-none', !open);
    popup.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    if (open) {
      ping?.remove();
      marcarVisto();
      void comecarConversa();
    }
  }

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(!isOpen);
  });
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('click', (e) => {
    if (isOpen && widget && !widget.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) setOpen(false);
  });

  // Etapas de escolha única (1, 2 e 4): clique avança sozinho
  inputs?.addEventListener('click', (e) => {
    const alvo = (e.target as HTMLElement).closest<HTMLButtonElement>('.wa-chip-btn:not(.wa-multi)');
    if (!alvo) return;
    const step = alvo.closest('.wa-step');
    const campo =
      step?.dataset.step === '1' ? 'momento' : step?.dataset.step === '2' ? 'faturamento' : 'investimento';
    void avancar(campo, alvo.dataset.value ?? '');
  });

  // Etapa 3: múltipla escolha + botão continuar
  inputs?.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.wa-chip-btn.wa-multi');
    if (chip) {
      chip.classList.toggle('wa-selected');
      return;
    }
    if ((e.target as HTMLElement).closest('#wa-produtos-ok')) {
      const sel = Array.from(
        inputs.querySelectorAll<HTMLButtonElement>('.wa-chip-btn.wa-selected')
      ).map((b) => b.dataset.value);
      const valor = sel.length ? sel.join(', ') : 'Ainda não sei — quero orientação';
      void avancar('produtos', valor);
    }
  });

  function showError(msg: string) {
    if (!error) return;
    error.textContent = msg;
    error.classList.remove('hidden');
  }

  // Etapa 5: envio
  document.getElementById('wa-enviar')?.addEventListener('click', () => {
    if (!error) return;
    error.classList.add('hidden');
    const nome = (document.getElementById('wa-nome') as HTMLInputElement).value.trim();
    const whats = (document.getElementById('wa-whats') as HTMLInputElement).value.trim();
    const email = (document.getElementById('wa-email') as HTMLInputElement).value.trim();

    if (nome.length < 2) return showError('Me diz seu nome pra continuar 😉');
    if (whats.replace(/\D/g, '').length < 10) return showError('Confira o WhatsApp digitado — parece incompleto.');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError('Confira o e-mail digitado — parece incompleto.');

    respostas.nome = nome;
    respostas.whats = whats;
    respostas.email = email;

    const pagina = `${location.pathname}` || '/';
    const lines = [
      '*Marca Lab — Nova cotação*',
      '',
      '*Origem:* Popup do site',
      `*Momento:* ${respostas.momento ?? ''}`,
      `*Faturamento atual:* ${respostas.faturamento ?? ''}`,
      `*Produtos de interesse:* ${respostas.produtos ?? '—'}`,
      `*Investimento previsto:* ${respostas.investimento ?? ''}`,
      '',
      `*Nome:* ${nome}`,
      `*WhatsApp:* ${whats}`,
      `*E-mail:* ${email}`,
      `*Página:* ${pagina}`,
    ];
    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(lines.join('\n'))}`;

    inputs?.querySelectorAll('.wa-step').forEach((el) => el.classList.add('hidden'));
    void botSay('Perfeito, ' + nome.split(' ')[0] + '! Abrindo seu WhatsApp com tudo preenchido… 🚀', 400).then(() => {
      window.open(url, '_blank', 'noopener');
      setTimeout(() => setOpen(false), 1600);
    });
  });

  // ---- Abertura automática (padrão Ekoncepto) ----
  // Após AUTO_ABRIR_MS na página, o chat abre sozinho — mas apenas:
  // 1× por sessão, se a pessoa ainda não abriu, e com a aba visível.
  if (!jaViuNestaSessao()) {
    setTimeout(() => {
      if (isOpen || jaViuNestaSessao()) return;
      if (document.hidden) {
        // aba em segundo plano: espera ficar visível para não "perder" a abertura
        const aoFicarVisivel = () => {
          document.removeEventListener('visibilitychange', aoFicarVisivel);
          if (!isOpen && !jaViuNestaSessao()) setOpen(true);
        };
        document.addEventListener('visibilitychange', aoFicarVisivel);
        return;
      }
      setOpen(true);
    }, AUTO_ABRIR_MS);
  }
</script>
