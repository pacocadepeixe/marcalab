---
/**
 * Seção CTA padrão usada ao final das páginas (funil de cotação).
 */
import { SITE } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pronto para lançar a sua marca de suplementos?',
  description = 'Solicite uma cotação gratuita: informe os produtos, quantidades e formatos e nossa equipe responde com condições, prazos e todo o suporte para você começar.',
} = Astro.props;
---

<section class="section bg-brand-800">
  <div class="container-site text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-brand-100">{description}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href={SITE.contact.whatsapp} class="btn-accent px-7! py-3.5! text-base!" rel="noopener" target="_blank">
        <Icon name="whatsapp" class="h-5 w-5" />
        Falar no WhatsApp
      </a>
      <a href="/contato" class="btn-outline-light px-7! py-3.5! text-base!">
        Solicitar cotação
      </a>
    </div>
    <p class="mt-6 text-sm text-brand-200">
      Atendimento em horário comercial · Resposta em até 1 dia útil
    </p>
  </div>
</section>
