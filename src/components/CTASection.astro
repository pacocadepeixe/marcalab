---
/**
 * Seção CTA padrão usada ao final das páginas (funil de cotação).
 */
import { SITE, START_PRICE } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sua marca pode estar à venda em 30 dias.',
  description = `Comece com um lote a partir de ${START_PRICE} e deixe produção, laudos e burocracia com a gente. Você foca no que gera dinheiro: audiência e vendas. Resposta em minutos, no WhatsApp.`,
} = Astro.props;
---

<section class="section bg-brand-800">
  <div class="container-site text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-brand-100">{description}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/contato" class="btn-accent px-7! py-3.5! text-base!">
        <Icon name="sparkle" class="h-5 w-5" />
        Quero minha marca no rótulo
      </a>
      <a
        href={SITE.contact.whatsapp}
        class="btn-outline-light px-7! py-3.5! text-base!"
        rel="noopener"
        target="_blank"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        Prefere WhatsApp? Chama direto
      </a>
    </div>
    <p class="mt-6 text-sm text-brand-200">
      Primeiro lote a partir de {START_PRICE} · Atendimento em horário comercial
    </p>
  </div>
</section>
