---
/**
 * Ícones SVG inline (sem dependências externas).
 * Uso: <Icon name="bolt" class="h-6 w-6" />
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

const icons: Record<string, string> = {
  bolt: '<path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  drop: '<path d="M12 2s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/>',
  sparkle: '<path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"/>',
  flame: '<path d="M12 22c4.4 0 8-3.6 8-8 0-5-4-8-5.5-11C14 6 13 7.5 12 8.5 11 7 10.5 5 10.5 3 7 5.5 4 10 4 14c0 4.4 3.6 8 8 8z"/>',
  fire: '<path d="M12 22c4.4 0 8-3.6 8-8 0-5-4-8-5.5-11C14 6 13 7.5 12 8.5 11 7 10.5 5 10.5 3 7 5.5 4 10 4 14c0 4.4 3.6 8 8 8z"/>',
  leaf: '<path d="M4 20c0-9 5-16 16-16 0 11-7 16-16 16zM4 20c4-4 8-7 12-9"/>',
  chart: '<path d="M3 21h18M6 17V9m5 8V5m5 12v-6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  'arrow-right': '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  'arrow-left': '<path d="M19 12H5m6 6-6-6 6-6"/>',
  whatsapp:
    '<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1a14 14 0 0 1-5.9-5.2c-.6-1-.9-1.9-.7-2.7.1-.5.6-1.3 1.1-1.5.3-.1.7-.1.9.3l.7 1.4c.1.3 0 .5-.1.7l-.4.5c-.1.2-.2.4 0 .7a9.6 9.6 0 0 0 3.8 3.3c.3.1.5.1.7-.1l.6-.7c.2-.2.4-.2.6-.1l1.4.7c.4.2.4.6.3 1z" fill="currentColor" stroke="none"/>',
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-13h4v2M2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3A19.5 19.5 0 0 1 5.2 13 19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.9 2.1z"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
  factory: '<path d="M2 20V8l7 5V8l7 5V4h6v16H2z"/>',
  flask: '<path d="M9 2h6M10 2v6.5L4.5 18A2 2 0 0 0 6.3 21h11.4a2 2 0 0 0 1.8-3L14 8.5V2"/><path d="M7 15h10"/>',
  truck: '<path d="M1 3h13v13H1zM14 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  tag: '<path d="M2 12l10-10 10 10-10 10z"/><circle cx="8" cy="8" r="1.5" fill="currentColor"/>',
  doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M21 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  x: '<path d="M18 6 6 18M6 6l12 12"/>',
};

const paths = icons[name] ?? icons.check;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={paths}
/>
