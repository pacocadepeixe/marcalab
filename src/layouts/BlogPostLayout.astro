---
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE, BLOG_CATEGORIES, IMAGES, START_PRICE, type BlogCategory } from '../data/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, description, quickAnswer, pubDate, updatedDate, category, faq } = post.data;

const canonical = `/blog/${post.id}`;
const dateFormatted = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
const updatedFormatted = updatedDate?.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'pt-BR',
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: SITE.author,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', SITE.url).href,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(canonical, SITE.url).href,
  },
  image: new URL('/og-image.png', SITE.url).href,
};

const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const schemas = [articleSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" schema={schemas}>
  <article class="section">
    <div class="container-site">
      <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: title }]} />

      <header class="mx-auto mt-8 max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <a
            href={`/blog/categoria/${category}`}
            class="inline-flex rounded-full bg-accent-50 px-3 py-1 font-semibold text-accent-800 ring-1 ring-accent-200 hover:bg-accent-100"
          >
            {BLOG_CATEGORIES[category as BlogCategory].label}
          </a>
          <time datetime={pubDate.toISOString()} class="font-medium text-slate-500">
            Publicado em {dateFormatted}
          </time>
          {
            updatedFormatted && (
              <span class="text-slate-400">
                · Atualizado em {updatedFormatted}
              </span>
            )
          }
        </div>
        <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-[2.75rem] lg:leading-[1.15]">
          {title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">{description}</p>
      </header>

      <figure class="mx-auto mt-8 max-w-3xl overflow-hidden rounded-3xl shadow-md">
        <img
          src={IMAGES.blog[category as BlogCategory]}
          alt={`Imagem da categoria ${BLOG_CATEGORIES[category as BlogCategory].label}`}
          class="aspect-[3/1] w-full object-cover"
          width="1200"
          height="400"
          loading="eager"
        />
      </figure>

      <div class="mx-auto mt-10 max-w-3xl">
        {
          quickAnswer && (
            <div class="quick-answer">
              <h2>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                Resposta rápida
              </h2>
              <p class="leading-relaxed text-slate-700">{quickAnswer}</p>
            </div>
          )
        }

        <div class="prose-blog mt-10">
          <Content />
        </div>

        {
          faq.length > 0 && (
            <div class="mt-14">
              <FAQ items={faq} title="Perguntas frequentes sobre este tema" />
            </div>
          )
        }

        <div class="mt-12 rounded-2xl bg-slate-900 p-6 sm:p-8">
          <h2 class="text-xl font-bold text-white sm:text-2xl">
            Quer produzir este produto com a sua marca?
          </h2>
          <p class="mt-3 leading-relaxed text-slate-300">
            A {SITE.name} produz este produto com a sua marca — formulação, rótulo, laudos e
            apoio na regularização. Primeiro lote a partir de {START_PRICE}.
          </p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href={SITE.contact.whatsapp} class="btn-accent" rel="noopener" target="_blank">
              Falar no WhatsApp
            </a>
            <a href="/produtos" class="btn-outline-light">
              Ver produtos
            </a>
          </div>
        </div>
      </div>

      {
        related.length > 0 && (
          <section class="mx-auto mt-16 max-w-5xl" aria-label="Artigos relacionados">
            <h2 class="text-2xl font-bold tracking-tight text-slate-900">Continue lendo</h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((p) => (
                <BlogCard post={p} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>

  <CTASection />
</BaseLayout>
